# ===================================================
# RATE IT - CONFIGURATION DE PRODUCTION (.env)
# ===================================================
# Copiez ce fichier sous le nom .env sur votre serveur de production :
# cp .env.production.example .env

# --- BASE DE DONNÉES POSTGRESQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGER_CE_MOT_DE_PASSE_TRES_FORT_POUR_LA_PROD
POSTGRES_DB=rate_it

# --- AUTHENTIFICATION & SÉCURITÉ ---
# Mot de passe du panel d'administration (/admin)
ADMIN_PASSWORD=CHANGER_CE_MOT_DE_PASSE_ADMIN_COMPLEXE

# Origines autorisées pour les requêtes HTTP et connexions WebSockets (séparées par des virgules)
ALLOWED_ORIGINS=https://rate-it.fr,https://www.rate-it.fr

# Nom d'utilisateur Twitch autorisé pour les messages d'annonces spéciales
SPECIAL_TWITCH_USER=ryrynoceros_

# --- CONFIGURATION FRONTEND (Injecté au build Docker) ---
NEXT_PUBLIC_APP_URL=https://rate-it.fr
NEXT_PUBLIC_WS_URL=https://rate-it.fr
