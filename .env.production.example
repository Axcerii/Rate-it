# ===================================================
# RATE IT - CONFIGURATION GLOBALE DE PRODUCTION (.env)
# ===================================================
# Copiez ce fichier sous le nom .env à la racine de votre projet sur votre VPS :
# cp .env.production.example .env

# --- BASE DE DONNÉES POSTGRESQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGER_CE_MOT_DE_PASSE_TRES_FORT_POUR_LA_PROD
POSTGRES_DB=rate_it
# Utilisé pour le dev local hors conteneur (Docker utilise le réseau interne postgres:5432)
# DATABASE_URL=postgresql://postgres:CHANGER_CE_MOT_DE_PASSE@localhost:5434/rate_it

# --- REDIS ---
# Utilisé pour le dev local hors conteneur (Docker utilise redis:6379)
# REDIS_URL=redis://localhost:6379

# --- BACKEND ---
NODE_ENV=production
PORT=4000
# Mot de passe administrateur complexe pour accéder au panel (/admin)
ADMIN_PASSWORD=CHANGER_CE_MOT_DE_PASSE_ADMIN_COMPLEXE
# Nom d'utilisateur Twitch autorisé pour les messages d'annonces spéciales
SPECIAL_TWITCH_USER=ryrynoceros_
# Origines autorisées pour les requêtes HTTP et connexions WebSockets (séparées par des virgules)
# Vous pouvez y mettre vos domaines, sous-domaines ou l'IP de votre VPS (avec ou sans http/https et ports)
ALLOWED_ORIGINS=https://rate-it.fr,https://www.rate-it.fr,51.91.126.16

# --- FRONTEND (Injecté au build Docker) ---
# URL publique de votre application Web
NEXT_PUBLIC_APP_URL=https://rate-it.fr
# URL WebSocket du backend (si proxy Nginx sur le même domaine, mettez l'URL du domaine)
NEXT_PUBLIC_WS_URL=https://rate-it.fr

# --- PORTS LOCAUX DU VPS (Modifiez si déjà utilisés par une autre app sur votre serveur) ---
FRONTEND_PORT=3000
BACKEND_PORT=4000
